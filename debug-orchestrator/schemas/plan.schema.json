{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Implementation plan",
  "type": "object",
  "required": ["summary", "steps", "assumptions", "risks"],
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "One paragraph: what will change and why that addresses the task."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered concrete edits. Each names the file it touches.",
      "items": {
        "type": "object",
        "required": ["file", "change"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "change": { "type": "string", "minLength": 1 }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "description": "Everything taken on faith. The critic attacks these first.",
      "items": { "type": "string" }
    },
    "risks": {
      "type": "array",
      "description": "What could break, and how it would show up.",
      "items": { "type": "string" }
    }
  }
}
